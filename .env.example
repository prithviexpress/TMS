# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_strong_password

# ── JWT ───────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-256-bit-random-hex-secret

# ── MinIO / Object Storage ────────────────────────────────────────
MINIO_USER=tmsadmin
MINIO_PASSWORD=changeme_minio

# ── Grafana ───────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── SMS / WhatsApp (MSG91 for India) ─────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MSILTM

# ── WhatsApp Business API ─────────────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── IoT / LoRaWAN ────────────────────────────────────────────────
# Pre-shared key that Chirpstack sends in the X-API-Key header
LORAWAN_INGEST_API_KEY=change-this-lorawan-key

# ── Hardware (LED displays and K70 bay lights) ────────────────────
K70_GATEWAY_IP=192.168.10.50
LED_DISPLAY_GATE2_IP=192.168.10.51
LED_DISPLAY_PARKING_EXIT_IP=192.168.10.52
